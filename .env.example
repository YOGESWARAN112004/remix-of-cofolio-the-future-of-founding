# Client-side (exposed to the browser bundle — VITE_ prefix required)
VITE_GOOGLE_SHEETS_URL=your_google_apps_script_url_here

# --- Server-side only (used by api/waitlist.ts) ---
# Do NOT prefix these with VITE_ — that would bundle secrets into client JS.
# Set these in your Vercel project's Environment Variables, not in a committed file.

# Supabase (Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMTP (confirmation email)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Cofolio <hello@cofolio.com>"
